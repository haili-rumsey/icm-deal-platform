# Copy to .env.local for local development. In production these live in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Random secret that signs sign-in tokens and cookies.
# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Resend API key (resend.com → API Keys). Sends the sign-in emails.
RESEND_API_KEY=

# Sender for sign-in emails. onboarding@resend.dev works only in Resend test mode,
# which delivers only to the Resend account owner. Change once a domain is verified.
EMAIL_FROM="ICM Deal Platform <onboarding@resend.dev>"

# Neon Postgres connection string. Set automatically on Vercel by the Neon integration;
# copy it here for local development.
DATABASE_URL=

# Google Geocoding API key (Google Cloud → APIs & Services → Credentials), restricted
# to the Geocoding API. Optional: without it, "Look up" says it isn't set up and users
# save properties without a Google match (flagged for cleanup).
GOOGLE_MAPS_API_KEY=
